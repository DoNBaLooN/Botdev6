# McQueen Connection Support Bot Configuration

# Telegram Bot Settings
# Создайте нового бота через @BotFather для технической поддержки
# Название проекта (отображается в интерфейсе бота поддержки)
PROJECT_NAME=Solobot
MAIN_BOT_USERNAME=@Solobot_bot
# Токен бота поддержки от @BotFather
BOT_TOKEN=your_support_bot_token_here

# ID чата/группы для техподдержки (сделайте группу с форумом/топиками)
# Узнать ID можно через @username_to_id_bot
SUPPORT_CHAT_ID=-1231231321
ADMIN_IDS=123456789,987654321

# GigaChat API Settings
# Токен для GigaChat API (получить на https://developers.sber.ru/portal/products/gigachat-api)
GIGACHAT_TOKEN=your_gigachat_token_here
# Включить/выключить ответы ИИ (true/false)
GIGACHAT_ENABLED=true

# Настройки техподдержки для GigaChat промптов (НОВОЕ!)
SUPPORT_SERVICE_NAME=Ваш VPN Сервис
SUPPORT_BOT_USERNAME=@ваш_основной_бот
SUPPORT_NEWS_CHANNEL=@ваш_канал_новостей
SUPPORT_VPN_PROTOCOL=VLESS
SUPPORT_APP_NAME_IOS=Название приложения iOS
SUPPORT_APP_NAME_ANDROID=Название приложения Android

# Настройки кнопки "Позвать оператора"
# На каком по счету сообщении от ИИ показывать кнопку "Позвать оператора"
# Например: 3 = кнопка появится на третьем сообщении от бота
# 1 = кнопка появится сразу на первом сообщении
# 0 = кнопка никогда не появится автоматически
OPERATOR_BUTTON_AFTER_MESSAGE=3

DEBUG=False
LOG_LEVEL=ERROR
MAIN_BOT_INTEGRATION=True
